# HLS Proxy
HLS_PROXY_PORT=8089
HLS_PROXY_UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
HLS_PROXY_REFERER=

# Segment prefetch — fetch upcoming segments in the background to reduce
# client-side buffering and stuttering. Set HLS_PREFETCH_SEGMENTS=0 to disable.
HLS_PREFETCH_SEGMENTS=3
HLS_SEGMENT_CACHE_SIZE=20

# Playlist cache TTL — serve cached playlist for this many seconds before
# re-fetching upstream. Prevents flooding the upstream when the HLS client
# polls aggressively (e.g. Jellyfin polls 3x/sec when buffering).
HLS_PLAYLIST_CACHE_TTL=2.0

# Retry logic — retry transient upstream errors (timeouts, 5xx) before
# giving up. Each retry is logged. Set HLS_FETCH_RETRIES=0 to disable.
HLS_FETCH_RETRIES=2
HLS_FETCH_RETRY_DELAY=1.0

# M3U Refresh
M3U_OUTPUT=/path/to/jellyfin/config/iptv.m3u
HLS_PROXY_URL=http://127.0.0.1:8089
CHANNELS_CONF=/path/to/channels.conf
